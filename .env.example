# Local database credentials; change the password in the ignored .env file.
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=payments
DB_PORT=5432
APP_PORT=8080
# make up prompts for a dedicated local account when these values are missing.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
LOG_LEVEL=info
DB_STARTUP_TIMEOUT=5s
READINESS_TIMEOUT=1s
HTTP_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=11s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_GRACE=10s
CLEANUP_TIMEOUT=5s
COMPOSE_STOP_GRACE_PERIOD=20s
# Optional Stripe CLI profile, used with a later webhook feature.
STRIPE_API_KEY=

# make up prompts for your own sandbox secret when STRIPE_SECRET_KEY is missing.
STRIPE_SECRET_KEY=
APP_BASE_URL=http://localhost:8080
PAYMENT_CURRENCY=usd
PAYMENT_MIN_AMOUNT=50
PAYMENT_MAX_AMOUNT=100000
CHECKOUT_REQUEST_TIMEOUT=10s
STRIPE_CALL_TIMEOUT=2s
STRIPE_RETRY_BUDGET=7s
STRIPE_MAX_ATTEMPTS=3
