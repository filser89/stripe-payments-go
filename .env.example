# Local database credentials; change the password in the ignored .env file.
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_DB=payments
DB_PORT=5432
APP_PORT=8080
LOG_LEVEL=info
DB_STARTUP_TIMEOUT=5s
READINESS_TIMEOUT=1s
HTTP_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_GRACE=10s
CLEANUP_TIMEOUT=5s
COMPOSE_STOP_GRACE_PERIOD=20s
# Optional Stripe CLI profile, used with a later webhook feature.
STRIPE_API_KEY=
